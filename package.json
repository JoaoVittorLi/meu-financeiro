{
  "name": "meu-financeiro-desktop",
  "version": "0.9.5-beta.8",
  "private": true,
  "description": "Meu Financeiro — transações, conciliação, planejamento e simulação de compra usando fluxo de caixa diário",
  "main": "electron/main.cjs",
  "scripts": {
    "compile": "tsc --project tsconfig.json && node scripts/build-finance-ledger.cjs",
    "test:db": "npm run compile && node --test tests/*.test.cjs",
    "test:asar": "node --test tests/renderer-asar.integration.cjs",
    "test:electron-smoke": "node scripts/d1-electron-smoke.cjs",
    "test:types": "tsc --project tsconfig.json --noEmit",
    "test": "npm run test:db",
    "start": "npm run compile && electron .",
    "dist:windows": "npm run test && npm run test:asar && npm run provenance:create && npm run provenance:verify && electron-builder --win portable nsis --x64 --publish never",
    "provenance:create": "node scripts/renderer-provenance.cjs create",
    "provenance:verify": "node scripts/renderer-provenance.cjs verify"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.0.0",
    "typescript": "5.8.3",
    "@electron/asar": "4.3.1"
  },
  "build": {
    "appId": "app.local.meufinanceiro.rcall01",
    "productName": "Meu Financeiro RC Experimental",
    "asar": true,
    "files": [
      "app/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MeuFinanceiro-Instalador-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MeuFinanceiro-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  }
}
