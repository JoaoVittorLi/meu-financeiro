{
  "appId": "app.local.meufinanceiro.auditoria",
  "productName": "MeuFinanceiro-Auditoria",
  "asar": true,
  "extraMetadata": {
    "main": "electron/audit-main.cjs"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "directories": {
    "output": "release-audit"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "MeuFinanceiro-Auditoria-Backup-${arch}.${ext}"
  }
}
